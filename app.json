{
  "expo": {
    "name": "PharmaSign",
    "slug": "pharmasign",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "pharmasign",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PharmaSign utilise votre position pour centrer la carte et calculer la distance aux interprètes proches.",
        "NSPhotoLibraryUsageDescription": "PharmaSign a besoin d'accéder à vos photos pour votre photo de profil.",
        "NSMicrophoneUsageDescription": "PharmaSign utilise le microphone pour transcrire la parole en texte pendant vos consultations médicales.",
        "NSSpeechRecognitionUsageDescription": "PharmaSign utilise la reconnaissance vocale pour retranscrire vos consultations médicales en temps réel."
      }
    },
    "android": {
      "package": "com.tomcaucigh.pharmasign",
      "versionCode": 1,

      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [{ "scheme": "vnd.youtube" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "PharmaSign utilise le microphone pour transcrire la parole en texte pendant vos consultations médicales.",
          "speechRecognitionPermission": "PharmaSign utilise la reconnaissance vocale pour retranscrire vos consultations médicales en temps réel."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PharmaSign a besoin d'accéder à vos photos pour votre photo de profil."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2A9D8F",
          "dark": {
            "backgroundColor": "#2A9D8F"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "29f9feb1-ff42-46b0-8ee8-99f2b5f0a234"
      }
    }
  }
}
