rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────
    function authed() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Lit le rôle dans Firestore (1 get() par évaluation — lazy dans les OR chains)
    function userRole() {
      return get(/databases/$(database)/documents/users/$(uid())).data.get('role', '');
    }

    function isAdmin() {
      return authed() && userRole() == 'admin';
    }

    function isInterprete() {
      return authed() && userRole() == 'interprete';
    }

    // ── users/{userId} ───────────────────────────────────────────
    match /users/{userId} {
      // Chaque utilisateur lit son propre profil ; admin lit tout
      allow read: if authed() && (userId == uid() || isAdmin());

      // Inscription : chacun crée son propre profil, jamais admin ni brevet pré-validé
      allow create: if authed() && userId == uid() &&
                       request.resource.data.role in ['sourd', 'interprete', 'apprenti'] &&
                       request.resource.data.get('brevetValidated', false) == false;

      // Mise à jour du profil, sauf les champs décidés par l'admin
      allow update: if authed() && userId == uid() &&
                       !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['role', 'brevetValidated', 'brevetRefused', 'brevetRefusalReason']);

      // Apprenti dont le brevet a été validé par l'admin → passe interprète
      allow update: if authed() && userId == uid() &&
                       resource.data.role == 'apprenti' &&
                       resource.data.get('brevetValidated', false) == true &&
                       request.resource.data.role == 'interprete' &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);

      // Admin : validation des brevets, changement de rôle
      allow update: if isAdmin();

      // Suppression de compte par l'utilisateur lui-même (exigée par le Play Store)
      allow delete: if authed() && (userId == uid() || isAdmin());
    }

    // ── appointments/{apptId} ────────────────────────────────────
    match /appointments/{apptId} {
      // Patient lit ses propres RDV
      allow read: if authed() && resource.data.patientId == uid();
      // Interprète lit ses missions assignées
      allow read: if authed() && resource.data.interpreterId == uid();
      // Interprète lit toutes les demandes en attente (bourse de missions)
      allow read: if isInterprete() && resource.data.status == 'pending';
      // Interprète lit les demandes qu'il a refusées (taux d'acceptation)
      allow read: if isInterprete() && uid() in resource.data.get('declinedBy', []);
      // Admin lit tout
      allow read: if isAdmin();

      // Patient (sourd) crée un RDV en son nom, sans interprète désigné.
      // Durée en minutes (absente sur les anciennes versions de l'appli).
      allow create: if authed() &&
                       request.resource.data.patientId == uid() &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.interpreterId == null &&
                       request.resource.data.get('durationMin', 60) is int &&
                       request.resource.data.get('durationMin', 60) >= 15 &&
                       request.resource.data.get('durationMin', 60) <= 480;

      // Patient annule son propre RDV (seul le champ status peut changer → 'cancelled')
      allow update: if authed() &&
                       resource.data.patientId == uid() &&
                       request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['status']) &&
                       request.resource.data.status == 'cancelled';

      // Interprète accepte une demande en attente, en son propre nom
      allow update: if isInterprete() &&
                       resource.data.status == 'pending' &&
                       request.resource.data.status == 'accepted' &&
                       request.resource.data.interpreterId == uid() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'interpreterId', 'interpreterName',
                                   'interpreterHourlyRate', 'interpreterPhone']);

      // Interprète refuse : il ajoute seulement son propre uid à declinedBy
      allow update: if isInterprete() &&
                       resource.data.status == 'pending' &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['declinedBy']) &&
                       request.resource.data.declinedBy.toSet() ==
                         resource.data.get('declinedBy', []).toSet().union([uid()].toSet());

      // Interprète se désiste d'une mission qu'il a acceptée, au plus tard le jour du RDV :
      // la demande redevient « en attente » sans lui (ajouté à declinedBy).
      allow update: if isInterprete() &&
                       resource.data.status == 'accepted' &&
                       resource.data.interpreterId == uid() &&
                       timestamp.value(resource.data.date + 'T23:59:59Z') > request.time &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.interpreterId == null &&
                       request.resource.data.get('interpreterName', null) == null &&
                       request.resource.data.get('interpreterHourlyRate', null) == null &&
                       request.resource.data.get('interpreterPhone', null) == null &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'interpreterId', 'interpreterName', 'interpreterHourlyRate',
                                   'interpreterPhone', 'declinedBy']) &&
                       request.resource.data.declinedBy.toSet() ==
                         resource.data.get('declinedBy', []).toSet().union([uid()].toSet());

      // Participant met à jour la transcription vocale
      allow update: if authed() &&
                       (resource.data.patientId == uid() ||
                        resource.data.interpreterId == uid()) &&
                       request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['transcription', 'transcriptionUpdatedAt']);

      allow delete: if isAdmin();
    }

    // ── messages/{appointmentId}/chatMessages/{msgId} ────────────
    // Utilisé aussi en collection group (useUnreadMessages, useNotifications)
    match /messages/{appointmentId}/chatMessages/{msgId} {
      function appt() {
        return get(/databases/$(database)/documents/appointments/$(appointmentId)).data;
      }
      function isParticipant() {
        return authed() &&
               (appt().patientId == uid() || appt().interpreterId == uid());
      }

      // Lecture : participants du RDV uniquement
      allow read: if isParticipant();
      // Envoi : l'auteur doit être l'utilisateur connecté
      allow create: if isParticipant() &&
                       request.resource.data.senderId == uid();
      // Marquer comme lu : uniquement le destinataire, sur le seul champ 'read'
      allow update: if authed() &&
                       resource.data.recipientId == uid() &&
                       request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['read']);
    }

    // Requêtes collection group (badges non lus, notifications de chat) :
    // les règles ci-dessus ne s'appliquent pas aux collection groups.
    match /{path=**}/chatMessages/{msgId} {
      allow read: if authed() &&
                     (resource.data.recipientId == uid() || resource.data.senderId == uid());
    }

    // ── reviews/{reviewId} ───────────────────────────────────────
    match /reviews/{reviewId} {
      // Patient voit ses avis ; interprète voit les avis le concernant ; admin voit tout
      allow read: if authed() && (
                    resource.data.patientId == uid() ||
                    resource.data.interpreterId == uid() ||
                    isAdmin()
                  );
      // Patient note l'interprète de l'un de ses RDV (dédoublonnage dans le code)
      function reviewedAppt() {
        return get(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data;
      }
      allow create: if authed() &&
                       request.resource.data.patientId == uid() &&
                       request.resource.data.rating is number &&
                       request.resource.data.rating >= 1 &&
                       request.resource.data.rating <= 5 &&
                       reviewedAppt().patientId == uid() &&
                       reviewedAppt().interpreterId == request.resource.data.interpreterId;
      allow update, delete: if isAdmin();
    }

    // ── formations/{formId} ──────────────────────────────────────
    match /formations/{formId} {
      allow read: if authed();
      allow write: if isAdmin();
    }

    // ── reservations/{resId} ─────────────────────────────────────
    // Réservations de formations (useApprentisProgress)
    match /reservations/{resId} {
      allow read: if authed() && (resource.data.userId == uid() || isAdmin());
      allow create: if authed() && request.resource.data.userId == uid();
      allow update, delete: if authed() && resource.data.userId == uid();
    }

    // ── healthProfessionals/{profId} ─────────────────────────────
    match /healthProfessionals/{profId} {
      allow read: if authed();
      allow write: if isAdmin();
    }

    // ── equipmentReports/{reportId} ───────────────────────────────
    // Signalements collaboratifs de matériel médical en pharmacie
    match /equipmentReports/{reportId} {
      allow read: if isAdmin();
      allow create: if authed() &&
                       request.resource.data.userId == uid() &&
                       request.resource.data.categories is list &&
                       request.resource.data.pharmacyId is string;
      allow update, delete: if isAdmin();
    }

  }
}
